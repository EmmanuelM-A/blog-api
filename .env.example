# Server
NODE_ENV=development
PORT=5000
ALLOWED_ORIGIN=

# App
ACCESS_TOKEN_SECRET=some-access-token
REFRESH_TOKEN_SECRET=some-refresh-token

# Logging
LOG_LEVEL=debug
LOG_AS_JSON=false

# Database (Dev)
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# Database (Prod) - Test api interaction with prod db, comment out the above when in use
# MONGO_URI=
# REDIS_URL=
