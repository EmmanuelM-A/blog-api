# Main API ENV Variables
PORT=5000
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
NODE_ENV=production # change to 'development' for dev environment
LOG_LEVEL=info
LOG_TO_FILE=true

# Dev
DEV_MONGO_URI=mongodb://mongo_db:27017 # Docker Compose service name
DEV_REDIS_URL=redis://redis:6379 # Docker Compose service name

# Prod
PROD_MONGO_URI=change-me
PROD_REDIS_URL=change-me
