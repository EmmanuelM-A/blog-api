{
  "name": "blog-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "seed": "node src/utils/seed-admin.js",
    "bundle-docs": "npx swagger-cli bundle src/docs/v1/openapi.yaml -o src/docs/bundled-swagger.yaml -t yaml",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:clear": "docker-compose down -v",
    "docker:build": "docker build -f Dockerfile -t blog-api .",
    "docker:run": "docker run -d --name blog-api-container -p 5000:5000 --env-file .env blog-api"
  },
  "author": "Emmanuel M-A",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@redocly/cli": "^2.14.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "mongoose-uuid-ts": "^1.0.2",
    "redis": "^5.5.5",
    "swagger-combine": "^1.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "validator": "^13.15.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
